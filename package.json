{
  "name": "@plinth/facts",
  "version": "0.3.0",
  "description": "An MCP server that only holds facts: measure and recall, never judge.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yesid8/mcp-measure-and-recall.git"
  },
  "homepage": "https://github.com/Yesid8/mcp-measure-and-recall#readme",
  "bugs": {
    "url": "https://github.com/Yesid8/mcp-measure-and-recall/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "observability",
    "http",
    "websocket",
    "append-only"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "bin": {
    "facts-mcp": "./dist/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src test",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
